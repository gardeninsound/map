{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bearisland-relay",
  // The gardeninsound Cloudflare account (holds gardeninsound.website). Pinned so a deploy
  // can never land in someone's personal account by mistake.
  "account_id": "7de05f51e1fe91fd717fe174fcfba85d",
  "routes": [{ "pattern": "relay.gardeninsound.website", "custom_domain": true }],
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Not wrangler's default 8787, which other local tools tend to grab.
  "dev": { "port": 8790 },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "STATS", "class_name": "Stats" }
    ]
  },
  // Free accounts can only create SQLite-backed Durable Objects. Rooms store nothing;
  // Stats keeps the day-by-day counts (src/stats.ts).
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Stats"] }
  ],
  "vars": {
    // Comma-separated page origins allowed to connect; `*` is a wildcard.
    "ALLOWED_ORIGINS": "https://gardeninsound.website,https://www.gardeninsound.website,https://*-garden-preview.gardeninsound.workers.dev,http://localhost:*,http://127.0.0.1:*",
    // Pages whose rabbits count as visits (src/stats.ts): the live site only, not previews, dev or tests.
    "COUNT_ORIGINS": "https://gardeninsound.website,https://www.gardeninsound.website",
    "MAX_PEERS": "64"
  }
}
