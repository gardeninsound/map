{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bearisland-relay",
  // The gardeninsound Cloudflare account (holds gardeninsound.website). Pinned so a deploy
  // can never land in someone's personal account by mistake.
  "account_id": "7de05f51e1fe91fd717fe174fcfba85d",
  "routes": [{ "pattern": "relay.gardeninsound.website", "custom_domain": true }],
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Not wrangler's default 8787, which other local tools tend to grab.
  "dev": { "port": 8790 },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // Free accounts can only create SQLite-backed Durable Objects. The relay
  // stores nothing; this just picks the storage backend.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    // Comma-separated page origins allowed to connect; `*` is a wildcard.
    "ALLOWED_ORIGINS": "https://gardeninsound.website,https://www.gardeninsound.website,http://localhost:*,http://127.0.0.1:*",
    "MAX_PEERS": "64"
  }
}
